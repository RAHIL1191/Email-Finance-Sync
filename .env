# --- Backend Configuration ---
PORT=80
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://192.168.2.19:8081,http://192.168.2.19:19006

# --- Database Configuration ---
# Replace with your actual PostgreSQL connection string
DATABASE_URL='postgresql://neondb_owner:npg_3t5CBrbWcxQe@ep-autumn-rice-aqzo5tfa-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# --- Plaid Configuration ---
# Get these from the Plaid Dashboard: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# --- OpenRouter AI Configuration ---
# Get an API key from https://openrouter.ai/
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=your_openrouter_api_key

# --- Feature Flags ---
FEATURE_EMAIL_SYNC=true
FEATURE_PLAID_SYNC=true
FEATURE_MANUAL_TRANSACTIONS=true
FEATURE_ACCOUNTS=true
FEATURE_BILLS=true
FEATURE_AI_INSIGHTS=true
FEATURE_INSIGHTS=true
FEATURE_BUDGET=true
FEATURE_EXPORT=true
FEATURE_BACKEND_SYNC=true

# --- Mobile App (Frontend) Configuration ---
# These are used by Expo (must start with EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://192.168.2.19:80
EXPO_PUBLIC_DOMAIN=192.168.2.19:80
