# --- AI Provider Configuration ---
# AI_MODEL controls which model is used by BOTH /api/ai/chat and /api/ai/review.
# Change the model name here to switch — no code changes needed.
#
# ── Option A: OpenRouter (recommended) ─────────────────────────────────────────
# One API key gives access to Llama, Claude, Gemini, Mistral, and 200+ models.
# Sign up free at https://openrouter.ai/ and grab a key.
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=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
#
# Model options (just change AI_MODEL, keep the same key):
#   Llama 3.3 70B (default, good balance):  meta-llama/llama-3.3-70b-instruct
#   Claude 3.5 Sonnet (smartest):           anthropic/claude-3.5-sonnet
#   Claude 3 Haiku (cheapest/fastest):      anthropic/claude-3-haiku
#   Gemini 1.5 Pro:                         google/gemini-pro-1.5
#   Gemini 1.5 Flash (fast/cheap):          google/gemini-flash-1.5
#   Mistral 7B (lightweight):               mistralai/mistral-7b-instruct
AI_MODEL=qwen/qwen3-30b-a3b-instruct:free
# ── Option B: Ollama (fully local on your PC, no API key needed) ────────────────
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama pull llama3.2   (or phi3, mistral, gemma2, etc.)
# 3. Ollama runs a server on localhost:11434 automatically
# Uncomment the 3 lines below and comment out Option A above:
# AI_INTEGRATIONS_OPENROUTER_BASE_URL=http://localhost:11434/v1
# AI_INTEGRATIONS_OPENROUTER_API_KEY=ollama
# AI_MODEL=llama3.2
#
# ── Option C: OpenAI direct ────────────────────────────────────────────────────
# AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://api.openai.com/v1
# AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-...your-openai-key...
# AI_MODEL=gpt-4o-mini

# --- Feature Flags ---
FEATURE_EMAIL_SYNC=true
FEATURE_PLAID_SYNC=true
FEATURE_MANUAL_TRANSACTIONS=true
FEATURE_ACCOUNTS=true
FEATURE_BILLS=true
FEATURE_AI_INSIGHTS=true
FEATURE_INSIGHTS=true
FEATURE_BUDGET=true
FEATURE_EXPORT=true
FEATURE_BACKEND_SYNC=true

# --- Mobile App (Frontend) Configuration ---
