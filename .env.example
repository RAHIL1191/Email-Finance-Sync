# --- Backend Configuration ---
PORT=80
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://192.168.1.100:8081,http://192.168.1.100:19006

# --- Database Configuration ---
# Replace with your PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fintrack?sslmode=require

# --- Plaid Configuration ---
# Get these from the Plaid Dashboard: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_REFRESH_ENABLED=true

# --- AI Provider Configuration ---
# AI_MODEL controls which model is used by BOTH /api/ai/chat and /api/ai/review.
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODEL=qwen/qwen3-30b-a3b-instruct:free

# --- Cron & Agent Configuration ---
CRON_SECRET=your_cron_secret
TAVILY_API_KEY=your_tavily_api_key

# --- Feature Flags ---
FEATURE_EMAIL_SYNC=true
FEATURE_PLAID_SYNC=true
FEATURE_MANUAL_TRANSACTIONS=true
FEATURE_ACCOUNTS=true
FEATURE_BILLS=true
FEATURE_AI_INSIGHTS=true
FEATURE_INSIGHTS=true
FEATURE_BUDGET=true
FEATURE_EXPORT=true
FEATURE_BACKEND_SYNC=true

# --- Mobile App (Frontend) Configuration ---
# These are used by Expo (must start with EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:80
EXPO_PUBLIC_DOMAIN=localhost:80
